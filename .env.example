# Firebase Web App config — from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Default duration (minutes) a temporary booking is held before it expires.
# Also configurable at runtime from Admin > Settings (stored in Firestore settings/global).
VITE_DEFAULT_TEMP_BOOKING_MINUTES=15
